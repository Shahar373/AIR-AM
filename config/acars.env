# ============================================================================
#  AIR-AM  -  הגדרות ACARS (ברירת מחדל) ל-acarsdec
# ----------------------------------------------------------------------------
#  פורמט EnvironmentFile של systemd (KEY=VALUE, מנותח בבטחה - *לא* shell).
#  ⚠️ נכתב מחדש ע"י airam-web בכל מעבר למצב ACARS. ערוך כאן רק כדי לשנות את
#     ברירת המחדל לפני הפעלה ראשונה.
#
#  ACARS_FREQS - תדרי ACARS לפענוח (MHz, מופרדים ברווח). בנק ברירת המחדל "אירופה +
#                עולמי (131)": צביר אירופה (131.425/131.525/131.725/131.825/131.850)
#                + הראשי העולמי 131.550 (שעליו מופיעים גם מטוסי תדלוק/צבא אמריקאים)
#                + 130.450 (ARINC). span 1.4MHz => נכנס בחלון דגימה אחד (2.0MS/s).
#                ⚠️ כל הערוצים חייבים להיכנס בחלון ~2MHz אחד, *עד 8 ערוצים*. צביר
#                136.x רחוק ~5MHz => בנק נפרד (נבחר מה-UI), לא יחד עם 131.x.
#                ⚠️ נדרס ע"י airam-web לפי הבנק/התדרים שנבחרו בממשק.
#  ACARS_GAIN  - dB; ‎-10 => AGC אוטומטי (ברירת מחדל).
#  ACARS_RATEMULT - 160 => 2.0 MS/s, 192 => 2.4 MS/s.
#  ACARS_UDP   - יעד פיד ה-JSON (acarsdec -j -> airam-web). אל תשנה ללא צורך.
# ============================================================================
ACARS_FREQS=130.450 131.425 131.525 131.550 131.725 131.825 131.850
ACARS_GAIN=-10
ACARS_RATEMULT=160
ACARS_UDP=127.0.0.1:5556
