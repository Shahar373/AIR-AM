 #include "SoapySDRPlay.hpp"
 #include <iostream>
+#include <chrono>
+
+/*******************************************************************
+ * AIR-AM: טלמטריית RF מהחומרה (AIRAM_RF) — patch מקומי של AIR-AM
+ *
+ * אירועי overload ו-GainChange של ה-API נבלעו כאן בלי שום פלט (הערות
+ * בלבד ב-ev_callback), כך שלא היה דרך לדעת על רוויה *לפני* ה-AGC. אנחנו
+ * רושמים אותם ל-log של SoapySDR (stderr => journald של rtl_airband), ו-
+ * airam-web קורא אותם משם (חיפוש regex לא-מעוגן — ייתכן prefix כמו
+ * "[INFO] ").
+ *
+ * רמה SOAPY_SDR_INFO בכוונה: זו ברירת המחדל של SoapySDR כשאין
+ * SOAPY_SDR_LOG_LEVEL (LoggerC.cpp:17 ב-soapy-sdr-0.8.1), ו-defaultLogHandler
+ * מדפיס "[INFO] %s\n" בלי קודי ANSI (LoggerC.cpp:63) — ב-WARNING השורה הייתה
+ * עטופה ב-ESC[1m/ESC[33m (LoggerC.cpp:61).
+ *
+ * GainChange מוגבל-קצב: rtl_airband קורא setGainMode(true) תחת AGC
+ * (input-soapysdr.cpp:247), ש-SoapySDRPlay3 ממפה ל-sdrplay_api_AGC_CTRL_EN
+ * (Settings.cpp:557; spec 3.15: "Latest AGC scheme", מוגדר ע"י attack_ms/
+ * decay_ms שנשארים 0 כאן) — *לא* ה-AGC_50HZ של ברירת-המחדל (ההערה "AGC: 50Hz"
+ * ב-Settings.cpp:98 מתארת אותו, לא את מה שרץ אצלנו). קצב ה-GainChange האמיתי
+ * תחתיו לא מתועד — לא ידוע עד שיימדד על ה-Pi. כדי שפרץ לא יציף את journald
+ * רושמים רק כשהערך השתנה, ולכל היותר פעם ב-AIRAM_RF_GAIN_MIN_INTERVAL. ערך שהגיע בתוך החלון נשמר כ"ממתין" ונרשם
+ * בהזדמנות הראשונה אחרי שהחלון נגמר — מ-GainChange הבא *או* מ-readStream()
+ * (נקרא ברציפות ע"י הצרכן), כך שהערך *האחרון* של פרץ (הערך שה-AGC
+ * התייצב עליו — החשוב ביותר) לא הולך לאיבוד גם כשאין אירוע נוסף. המחיר:
+ * עיכוב של עד AIRAM_RF_GAIN_MIN_INTERVAL בדיווח, וערכי-ביניים בתוך פרץ
+ * לא נרשמים. ה-flush רץ על ת'רד הצרכן (readStream) ולא על ת'רד ה-API
+ * (rx_callback), כדי שכתיבה איטית ל-journald לא תעכב את זרם הדגימות.
+ * overload לא מוגבל: כל מעבר הוא קצה-מצב, ואיבוד קצה היה משאיר מצב שגוי.
+ *
+ * מצב סטטי לתהליך (לא פר-מכשיר): AIR-AM פותח RSP1B יחיד בתהליך. ב-RSPduo
+ * dual-tuner שני הטיונרים היו חולקים את מגבלת הקצב.
+ ******************************************************************/
+namespace {
+
+const std::chrono::milliseconds AIRAM_RF_GAIN_MIN_INTERVAL(1000);
+
+std::mutex airam_rf_mutex;
+bool airam_rf_logged = false;          // נרשם ערך כלשהו כבר?
+unsigned int airam_rf_logged_grdb = 0;
+unsigned int airam_rf_logged_lna = 0;
+std::chrono::steady_clock::time_point airam_rf_last_log;
+bool airam_rf_pending = false;         // ערך שעוד לא נרשם (מוגן ע"י המנעול)
+unsigned int airam_rf_pending_grdb = 0;
+unsigned int airam_rf_pending_lna = 0;
+// מסלול מהיר ל-readStream: קריאה אטומית בלבד כשאין מה לרשום
+std::atomic<bool> airam_rf_pending_flag(false);
+
+// have_new=true: ערך חדש מ-GainChange (נועל תמיד).
+// have_new=false: ניסיון flush מ-readStream (try_lock — לעולם לא ממתין).
+void airam_rf_gain(bool have_new, unsigned int grdb, unsigned int lna_grdb)
+{
+    unsigned int out_grdb = 0, out_lna = 0;
+    {
+        std::unique_lock<std::mutex> lock(airam_rf_mutex, std::defer_lock);
+        if (have_new)
+        {
+            lock.lock();
+            airam_rf_pending = true;
+            airam_rf_pending_grdb = grdb;
+            airam_rf_pending_lna = lna_grdb;
+        }
+        else if (!lock.try_lock())
+        {
+            return;
+        }
+        if (!airam_rf_pending)
+        {
+            airam_rf_pending_flag = false;
+            return;
+        }
+        if (airam_rf_logged && airam_rf_pending_grdb == airam_rf_logged_grdb
+                && airam_rf_pending_lna == airam_rf_logged_lna)
+        {
+            // חזר לערך שכבר נרשם — אין מה לדווח
+            airam_rf_pending = false;
+            airam_rf_pending_flag = false;
+            return;
+        }
+        const auto now = std::chrono::steady_clock::now();
+        if (airam_rf_logged && now - airam_rf_last_log < AIRAM_RF_GAIN_MIN_INTERVAL)
+        {
+            airam_rf_pending_flag = true;   // יירשם כשהחלון ייגמר
+            return;
+        }
+        out_grdb = airam_rf_pending_grdb;
+        out_lna = airam_rf_pending_lna;
+        airam_rf_logged = true;
+        airam_rf_logged_grdb = out_grdb;
+        airam_rf_logged_lna = out_lna;
+        airam_rf_last_log = now;
+        airam_rf_pending = false;
+        airam_rf_pending_flag = false;
+    }
+    // הכתיבה מחוץ למנעול; שתי כתיבות רחוקות זו מזו לפחות חלון שלם, כך
+    // שאין סיכון מעשי לסדר הפוך בין שני הת'רדים.
+    SoapySDR_logf(SOAPY_SDR_INFO, "AIRAM_RF gain grdb=%u lna_grdb=%u", out_grdb, out_lna);
+}
+
+// גבול-סשן + הוכחת-חיים, נקרא מ-activateStream *לפני* sdrplay_api_Init.
+// למה כאן ולא רק שורת האתחול של rtl_airband: (1) זו הראיה היחידה שהמודול
+// *המתוקן* הוא זה שנטען, ושה-log שלו (stderr) באמת מגיע לעוקב ב-airam-web —
+// סימן-הבנייה מוכיח רק שה-patch נבנה; בלי השורה הזו airam-web לא מציג "אין
+// עומס" (§12: שקט אינו "אין עומס"). (2) אותו זרם בדיוק כמו שורות ה-overload
+// (stderr => stream socket של journald), כך שהסדר ביניהן נשמר; שורת האתחול
+// של rtl_airband עוברת ב-syslog (/dev/log) — מקור אחר, בלי הבטחת סדר מולו.
+// לפני Init: ev_callback נרשם רק ב-Init, ולכן שום אירוע של הסשן לא קודם לה.
+// מאפס גם את מגבלת-הקצב, כדי שערך ה-gain הראשון של הסשן תמיד יירשם.
+void airam_rf_stream_start()
+{
+    {
+        std::lock_guard<std::mutex> lock(airam_rf_mutex);
+        airam_rf_logged = false;
+        airam_rf_pending = false;
+        airam_rf_pending_flag = false;
+    }
+    SoapySDR_log(SOAPY_SDR_INFO, "AIRAM_RF stream=start");
+}
+
+} // namespace
 
