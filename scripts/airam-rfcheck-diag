#!/usr/bin/env bash
# ============================================================================
#  AIR-AM  -  אבחון חומרה ל-🩺 בדיקת RF (docs/rf-check-design.md §10)
# ----------------------------------------------------------------------------
#  מריץ את שלב האבחון (D1–D8, ~90 שניות על ATIS ‏132.5) דרך ה-API המקומי של
#  airam-web — *אותו מסלול* כמו הכפתור "🔧 אבחון חומרה" בממשק: אותם סירובים,
#  אותה נעילה, ושחזור הקול בסוף. הסקריפט לא נוגע ב-SDR בעצמו.
#
#  הפלט לשליחה: בלוק הסיכום (מתחיל ב-"AIRAM-RFDIAG v1") והקובץ
#  /var/lib/airam/rfcheck_diagnose.json — שניהם.
#
#  שימוש:   sudo airam-rfcheck-diag
#  root נדרש כדי לקרוא את ה-PIN (‏/etc/airam/airam.env הוא 640, airam:airam).
#  יציאה: 0 — האבחון הסתיים והסיכום הודפס · 1 — שגיאה (הודעת השרת מודפסת).
# ============================================================================
set -euo pipefail

# ‏AIRAM_API_URL/AIRAM_ENV_FILE — לבדיקות בלבד (tests/test_rfcheck_api.py מריץ את הסקריפט
# מול airam-web האמיתי עם בודק מדומה). ‏sudo מאפס את הסביבה כברירת מחדל, כך שבשימוש רגיל אלה תמיד ברירות המחדל.
API="${AIRAM_API_URL:-http://127.0.0.1:8080}"
ENV_FILE="${AIRAM_ENV_FILE:-/etc/airam/airam.env}"
DIAG_FILE="/var/lib/airam/rfcheck_diagnose.json"
POLL_SEC="${AIRAM_POLL_SEC:-2}"   # לבדיקות: AIRAM_POLL_SEC
TIMEOUT_SEC=240          # האבחון עצמו ≤150ש' + פתיחה/שחזור; RuntimeMaxSec של היחידה 240

die() { printf '[X] %s\n' "$*" >&2; exit 1; }

[[ $EUID -eq 0 || -n "${AIRAM_ENV_FILE:-}" ]] || die "יש להריץ עם sudo (נדרש לקריאת ה-PIN מ-${ENV_FILE})."
command -v curl >/dev/null || die "curl לא מותקן."
command -v python3 >/dev/null || die "python3 לא מותקן."

# ה-PIN (אם הוגדר) — אותו קובץ ש-airam-web.service טוען (EnvironmentFile). הערך האחרון
# מנצח, כמו ב-systemd; רווחים בקצוות ומירכאות עוטפות מוסרים (app.py: ‎.strip()).
trim() { local v="$1"; v="${v#"${v%%[![:space:]]*}"}"; v="${v%"${v##*[![:space:]]}"}"; printf '%s' "$v"; }
PIN=""
if [[ -r "$ENV_FILE" ]]; then
  PIN="$(trim "$(sed -n 's/^[[:space:]]*AIRAM_PIN[[:space:]]*=//p' "$ENV_FILE" | tail -n 1)")"
  if [[ "$PIN" == \"*\" || "$PIN" == \'*\' ]]; then PIN="${PIN:1:${#PIN}-2}"; fi
  PIN="$(trim "$PIN")"
fi
# ⚠ ה-PIN עובר ל-curl דרך קובץ-קונפיג ב-stdin (‎-K -), **לא** כ-‎-H בשורת הפקודה: argv של
# תהליך קריא לכל משתמש מקומי (‎/proc/<pid>/cmdline, ‏ps) — וה-PIN הוא הסוד היחיד במערכת (§9).
pin_config() {
  [[ -n "$PIN" ]] || return 0
  local v="${PIN//\\/\\\\}"
  v="${v//\"/\\\"}"
  printf 'header = "X-AIRAM-PIN: %s"\n' "$v"
}
# ⚠ בלי Origin: ‏_guard בודק Origin רק כשהוא נשלח (בקשה מקומית, לא דפדפן).

# jget KEY — שדה מ-JSON ב-stdin (מפתח כ-argv, לא כחלק מהקוד). null/חסר => מחרוזת ריקה.
jget() {
  python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
except ValueError:
    sys.exit(0)
v = d.get(sys.argv[1]) if isinstance(d, dict) else None
if v is None:
    sys.exit(0)
print(json.dumps(v, ensure_ascii=False) if isinstance(v, (dict, list)) else
      ("true" if v is True else "false" if v is False else v))' "$1"
}

echo "==> מפעיל אבחון חומרה (כ-90 שניות, ATIS 132.5 — השמע ייעצר ויחזור לבד)..."
RESP="$(pin_config | curl -sS -K - -X POST -H "Content-Type: application/json" \
        --data '{"action":"start","phase":"diagnose"}' -w '\n%{http_code}' "${API}/api/rfcheck")" || die "אין חיבור ל-airam-web (${API}) — systemctl status airam-web"
CODE="${RESP##*$'\n'}"
BODY="${RESP%$'\n'*}"
if [[ "$CODE" != "200" ]]; then
  ERR="$(printf '%s' "$BODY" | jget error)"
  REASONS="$(printf '%s' "$BODY" | jget reasons)"
  die "השרת סירב (HTTP ${CODE}): ${ERR:-$BODY}${REASONS:+ — ${REASONS}}"
fi
RUN_ID="$(printf '%s' "$BODY" | jget run_id)"
[[ -n "$RUN_ID" ]] || die "תשובת התחלה בלי run_id: ${BODY}"
echo "    run_id=${RUN_ID}"

START=$SECONDS
STATUS=""
while :; do
  sleep "$POLL_SEC"
  STATUS="$(curl -sS "${API}/api/rfcheck")" || die "החיבור ל-airam-web אבד באמצע — הבדיקה ממשיכה ב-Pi; ר' journalctl -u airam-rfcheck"
  RUNNING="$(printf '%s' "$STATUS" | jget running)"
  PHASE="$(printf '%s' "$STATUS" | jget phase)"
  ELAPSED="$(printf '%s' "$STATUS" | jget elapsed)"
  STEP="$(printf '%s' "$STATUS" | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
except ValueError:
    sys.exit(0)
p = d.get("probe") if isinstance(d, dict) else None
print((p or {}).get("diag_step") or "")')"
  printf '    %-10s %5ss  %s\n' "${PHASE:-?}" "${ELAPSED:-?}" "$STEP"
  [[ "$RUNNING" == "true" ]] || break
  (( SECONDS - START < TIMEOUT_SEC )) || die "פג הזמן (${TIMEOUT_SEC}ש') — ר' journalctl -u airam-rfcheck -n 200"
done

ERR="$(printf '%s' "$STATUS" | jget error)"
RESTORE_OK="$(printf '%s' "$STATUS" | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
except ValueError:
    sys.exit(0)
r = d.get("restore") if isinstance(d, dict) else None
print("" if not isinstance(r, dict) else ("true" if r.get("ok") else "false"))')"
[[ "$RESTORE_OK" == "false" ]] && echo "[!] השמע לא חזר אוטומטית — ינסה שוב לבד תוך דקה (או לחץ ⏻ בממשק)." >&2
[[ -z "$ERR" ]] || die "האבחון נכשל: ${ERR} — ר' journalctl -u airam-rfcheck -n 200"

DIAG="$(curl -sS "${API}/api/rfcheck/export?kind=diagnose")" || die "הורדת תוצאת האבחון נכשלה."
DIAG_RUN="$(printf '%s' "$DIAG" | jget run_id)"
[[ "$DIAG_RUN" == "$RUN_ID" ]] || die "קובץ האבחון אינו של הריצה הזו (run_id=${DIAG_RUN:-חסר}) — ר' journalctl -u airam-rfcheck"
SUMMARY="$(printf '%s' "$DIAG" | jget summary_text)"
[[ -n "$SUMMARY" ]] || die "בקובץ האבחון אין בלוק סיכום."

echo
echo "==> בלוק הסיכום (להעתקה ולשליחה):"
echo "------------------------------------------------------------"
printf '%s\n' "$SUMMARY"
echo "------------------------------------------------------------"
echo "==> הקובץ המלא לשליחה: ${DIAG_FILE}"
exit 0
