#!/usr/bin/env python3
# ============================================================================
#  AIR-AM  -  ניסוי מסנן ה-IF של VDL2: האם מסנן ה-200kHz עולה לנו פריימים?
# ----------------------------------------------------------------------------
#  ר' docs/vdl2-if-filter-design.md. בקצרה (מאומת מהמקור): dumpvdl2 v2.6.0 מבקש
#  מ-SoapySDR רוחב = (הפרש התדרים) + 2×10500 = ‏271kHz לבנק ברירת המחדל, ו-
#  SoapySDRPlay3 מעגל *למטה* למסנן ה-200kHz (‏±100kHz). המרכז 136.85 ⇒ 136.725
#  ו-136.975 (ה-CSC העולמי) יושבים ב-±125kHz, מחוץ למעבר הנומינלי. כמה המסנן
#  האמיתי של ה-RSP1B מנחית שם — ואם זה עולה פריימים — רק החומרה יודעת.
#
#    sudo ~/AIR-AM/scripts/airam-vdl2-ifbw probe        # שלב 1: readback + צורת המסנן (~10 שניות)
#    sudo ~/AIR-AM/scripts/airam-vdl2-ifbw ab           # שלב 2: A/B משולב, 60 דק' (ABBA × 3)
#    sudo ~/AIR-AM/scripts/airam-vdl2-ifbw ab --minutes 120 --block 5
#         ~/AIR-AM/scripts/airam-vdl2-ifbw analyze /tmp/airam-vdl2-ifbw/<run>
#
#  A = הנתיב של היום (‎--soapysdr, מסנן 200kHz). B = הדרייבר הנייטיבי של dumpvdl2
#  (‎--sdrplay3, מסנן 1.536MHz קבוע בקוד). אותם תדרים, אותו oversample, אותו רווח.
#  הבקרה: הערוצים הפנימיים (±25kHz) נמצאים עמוק בתוך *שני* המסננים — אם B עדיף
#  רק בגלל הדרייבר/AGC, הוא עדיף גם שם. ההשוואה היא היחס חיצוני/פנימי, לא הספירה.
#
#  לפני ההרצה: ⏻ בממשק (standby). הכלי מסרב כשצרכן SDR פעיל או כשהמצב השמור אינו
#  off (airam-web היה מחזיר אותו באמצע). אל תיגע בממשק בזמן הריצה. ‏ab ארוך —
#  הרץ בתוך tmux/screen. Ctrl-C עוצר, משחרר את ה-SDR ומנתח את הבלוקים שהושלמו.
#
#  לא מותקן ולא משנה את AIR-AM: לא כותב ל-/etc ולא ל-state, לא מפעיל/עוצר שירותים.
#  כותב רק ל-/tmp/airam-vdl2-ifbw/<תאריך-שעה>/. ‏sudo — כמו airam-vdl2.service,
#  ש-dumpvdl2 בו רץ כ-root.
#
#  תלויות: dumpvdl2 (install.sh שלב 4c) עם ‎--sdrplay3 מקומפל (נבדק בהתחלה).
#  ‏probe בלבד: python3-soapysdr (חובה) ו-python3-numpy (לצורת המסנן; בלעדיו —
#  readback בלבד). ‏sudo apt install python3-soapysdr python3-numpy
# ============================================================================
import argparse
import json
import math
import os
import shutil
import signal
import socket
import statistics
import subprocess
import sys
import threading
import time
from datetime import datetime
from pathlib import Path

VDL2_ENV = Path("/etc/airam/vdl2.env")
STATE_PATH = Path("/var/lib/airam/state.json")
OUT_ROOT = Path("/tmp/airam-vdl2-ifbw")
DUMPVDL2 = "/usr/local/bin/dumpvdl2"
SDR_CONSUMERS = ("rtl_airband", "airam-acars", "airam-vdl2", "airam-satcom")
UDP_PORT = 5567               # ⚠ לא 5557 — airam-web מאזין שם תמיד (VDL2_UDP_PORT)

# בנק ברירת המחדל — זהה ל-VDL2_FREQS_DEFAULT ב-webtune/app.py (נבדק ב-tests).
# הכלי בודק *את הבנק הזה* ולא את מה שבמקרה כתוב ב-vdl2.env: בבנק "CSC בלבד" הערוץ
# היחיד במרכז ואין מה לבדוק.
DEFAULT_FREQS_MHZ = ("136.725", "136.775", "136.825", "136.875", "136.975")

# --- המודל מהמקור (תיעוד כקוד; ר' §2 במסמך) ----------------------------------
SYMBOL_RATE = 10500           # dumpvdl2.h
SPS = 10                      # dumpvdl2.h
OVERSAMPLE = 20               # ‎--oversample של airam-vdl2.service
SAMPLE_RATE = SYMBOL_RATE * SPS * OVERSAMPLE        # 2.1MS/s
NATIVE_BW = 1536000           # sdrplay3.c: ‏bwType = sdrplay_api_BW_1_536, קבוע
# SoapySDRPlay3 ‏getBwEnumForRate (Settings.cpp): הסף הראשון שהבקשה *קטנה* ממנו.
_SOAPY_BW_STEPS = ((300000, 200000), (600000, 300000), (1536000, 600000),
                   (5000000, 1536000), (6000000, 5000000), (7000000, 6000000),
                   (8000000, 7000000))


def dumpvdl2_bandwidth(freqs_hz):
    """calc_bandwidth (dumpvdl2.c v2.6.0) — מה ש-dumpvdl2 מבקש ב-setBandwidth."""
    return max(freqs_hz) - min(freqs_hz) + 2 * SYMBOL_RATE


def dumpvdl2_center(freqs_hz):
    """calc_centerfreq (dumpvdl2.c v2.6.0) — אמצע הטווח, חלוקת שלמים."""
    lo, hi = min(freqs_hz), max(freqs_hz)
    return lo + (hi - lo) // 2


def soapy_sdrplay_bw(requested_hz):
    """המסנן ש-SoapySDRPlay3 בוחר לבקשת setBandwidth (מעגל למטה, לא למעלה)."""
    for limit, bw in _SOAPY_BW_STEPS:
        if requested_hz < limit:
            return bw
    return 8000000


def mhz_to_hz(values):
    """'136.725' ⇒ 136725000. ⚠ ה-state/UI ב-MHz, dumpvdl2 ב-Hz (CLAUDE.md §12)."""
    return [int(round(float(v) * 1e6)) for v in values]


def classify(freqs_hz):
    """{freq: (offset_hz, group)} מול המרכז ש-dumpvdl2 יבחר. ‏outer = מחוץ לחצי-הרוחב
    הנומינלי של המסנן שנתיב A מקבל (200kHz ⇒ ±100kHz — מהשם BW_0_200, לא סף שלנו);
    ‏inner = בתוך חצי ממנו (עמוק במעבר של שני המסננים — הבקרה); mid = ביניהם (מדווח,
    לא נכנס להשוואה)."""
    center = dumpvdl2_center(freqs_hz)
    half = soapy_sdrplay_bw(dumpvdl2_bandwidth(freqs_hz)) / 2
    out = {}
    for f in freqs_hz:
        off = f - center
        if abs(off) > half:
            g = "outer"
        elif abs(off) <= half / 2:
            g = "inner"
        else:
            g = "mid"
        out[f] = (off, g)
    return out


# --- קונפיג ----------------------------------------------------------------
def read_env(path):
    """KEY=VALUE בסגנון EnvironmentFile (בלי shell). קובץ חסר ⇒ {}."""
    env = {}
    try:
        text = Path(path).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return env
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        env[k.strip()] = v.strip()
    return env


def parse_gain(value):
    """VDL2_GAIN מ-vdl2.env ⇒ None (AGC) או (ifgr, lna). ‏write_vdl2_env כותב רק
    ריק או ‎"--soapy-gain IFGR=%d,RFGR=%d"; כל דבר אחר ⇒ ValueError (לא מנחשים)."""
    value = (value or "").strip()
    if not value:
        return None
    parts = value.split()
    if len(parts) == 2 and parts[0] == "--soapy-gain":
        kv = dict(p.split("=", 1) for p in parts[1].split(",") if "=" in p)
        if set(kv) == {"IFGR", "RFGR"}:
            return int(kv["IFGR"]), int(kv["RFGR"])
    raise ValueError(f"VDL2_GAIN לא מוכר: {value!r}")


def parse_gain_arg(value):
    """‎--gain: ‏'agc' או 'IFGR,LNA' (למשל 40,0)."""
    if value.lower() == "agc":
        return None
    a, b = value.split(",")
    return int(a), int(b)


def build_cmd(arm, freqs_hz, gain, port=UDP_PORT, dumpvdl2=DUMPVDL2, device="0"):
    """ה-argv של כל זרוע. A = ה-ExecStart של airam-vdl2.service (קלט SoapySDR);
    B = הדרייבר הנייטיבי. מיפוי הרווח מדויק: ב-SoapySDRPlay3 ‏IFGR=gRdB ו-RFGR=LNAstate
    (setGain ב-Settings.cpp) ⇒ ב-sdrplay3 ‏‎--ifgr/--lna-state. בלי רווח — AGC בשניהם
    (⚠ לא אותו AGC: Soapy ‏AGC_CTRL_EN, נייטיבי AGC_5HZ; שניהם ‎-30dBFS)."""
    out = f"decoded:json:udp:address=127.0.0.1,port={port}"
    if arm == "A":
        cmd = [dumpvdl2, "--soapysdr", "driver=sdrplay", "--oversample", str(OVERSAMPLE)]
        if gain:
            cmd += ["--soapy-gain", "IFGR=%d,RFGR=%d" % gain]
    elif arm == "B":
        cmd = [dumpvdl2, "--sdrplay3", str(device), "--oversample", str(OVERSAMPLE)]
        if gain:
            cmd += ["--ifgr", str(gain[0]), "--lna-state", str(gain[1])]
    else:
        raise ValueError(arm)
    # msg-filter all: סופרים *כל* פריים מפוענח (כולל GSIF של תחנות קרקע), לא רק מה
    # שהפיד של AIR-AM מציג — יותר נתונים לאותו זמן.
    return cmd + ["--msg-filter", "all", "--output", out] + [str(f) for f in freqs_hz]


def schedule(n_blocks):
    """ABBA חוזר: מגמה ליניארית בתעבורה (בוקר⇐צהריים) מתקזזת בין הזרועות."""
    pat = "ABBA"
    return [pat[i % 4] for i in range(n_blocks)]


# --- פריימים ---------------------------------------------------------------
def parse_frame(obj):
    """פריים JSON של dumpvdl2 v2.6.0 (fmtr-json.c) ⇒ רשומה קומפקטית, או None."""
    v = obj.get("vdl2") if isinstance(obj, dict) else None
    if not isinstance(v, dict):
        return None
    try:
        freq = int(v.get("freq"))
    except (TypeError, ValueError):
        return None

    def num(key):
        x = v.get(key)
        return float(x) if isinstance(x, (int, float)) and not isinstance(x, bool) else None

    t_obj = v.get("t") if isinstance(v.get("t"), dict) else {}
    try:
        t = float(t_obj.get("sec") or 0) + float(t_obj.get("usec") or 0) / 1e6
    except (TypeError, ValueError):
        t = None
    avlc = v.get("avlc") if isinstance(v.get("avlc"), dict) else {}
    src = avlc.get("src") if isinstance(avlc.get("src"), dict) else {}
    st = str(src.get("type") or "").lower()
    who = "air" if st == "aircraft" else ("gnd" if st.startswith("ground") else None)
    return {"t": t, "f": freq, "sig": num("sig_level"), "noise": num("noise_level"),
            "fec": num("octets_corrected_by_fec"), "src": who}


class Receiver(threading.Thread):
    """מאזין UDP מקומי; כל פריים מתויג בבלוק שרץ ברגע ההגעה (רק dumpvdl2 אחד רץ)."""

    def __init__(self, port, out_path):
        super().__init__(daemon=True)
        self.sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        self.sock.bind(("127.0.0.1", port))          # תפוס ⇒ OSError כבר כאן, לפני כל SDR
        self.sock.settimeout(0.5)
        self.fh = open(out_path, "a", encoding="utf-8")
        self.block = None
        self.lock = threading.Lock()
        self.stop_evt = threading.Event()
        self.count = 0

    def set_block(self, idx):
        with self.lock:
            self.block = idx

    def run(self):
        while not self.stop_evt.is_set():
            try:
                data, _ = self.sock.recvfrom(65535)
            except socket.timeout:
                continue
            except OSError:
                break
            rx = time.time()
            try:
                rec = parse_frame(json.loads(data.decode("utf-8", errors="replace")))
            except ValueError:
                rec = None
            if rec is None:
                continue
            with self.lock:
                rec["b"], rec["rx"] = self.block, rx
                self.fh.write(json.dumps(rec) + "\n")
                self.fh.flush()
                self.count += 1

    def close(self):
        self.stop_evt.set()
        self.join(timeout=3)
        self.sock.close()
        with self.lock:
            self.fh.close()


# --- בדיקות מקדימות --------------------------------------------------------
def _run(cmd, timeout=10):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None


def active_consumers():
    busy = []
    for s in SDR_CONSUMERS:
        r = _run(["systemctl", "is-active", s])
        state = (r.stdout.strip() if r else "") or "?"
        if state in ("active", "activating", "reloading", "deactivating"):
            busy.append(f"{s} ({state})")
    return busy


def saved_mode(state_path=STATE_PATH):
    try:
        return json.loads(Path(state_path).read_text(encoding="utf-8")).get("app_mode", "off")
    except (OSError, ValueError, AttributeError):
        return None                                # אין state ⇒ התקנה טרייה = off


def preflight(need_root=True):
    """רשימת בעיות (ריקה = אפשר להתחיל). נקרא לפני הריצה *ובין כל שני בלוקים*."""
    problems = []
    if need_root and os.geteuid() != 0:
        problems.append("צריך sudo (dumpvdl2 רץ כ-root גם ב-airam-vdl2.service)")
    busy = active_consumers()
    if busy:
        problems.append("צרכן SDR פעיל: " + ", ".join(busy) + " — ⏻ בממשק (standby)")
    mode = saved_mode()
    if mode not in (None, "off"):
        problems.append(f"המצב השמור הוא '{mode}' — airam-web עלול להחזיר אותו באמצע "
                        "(reconcile/סריקה). ⏻ בממשק (standby)")
    return problems


def sdr_ready(timeout=30):
    """אותו probe כמו airam-wait-sdrplay: ה-API עונה *ואף לקוח לא מחזיק במכשיר*
    (מכשיר תפוס לא מוחזר מ-GetDevices). בלי לבעוט ב-sdrplay — הכלי לא משנה שירותים."""
    end = time.time() + timeout
    while True:
        r = _run(["SoapySDRUtil", "--find=driver=sdrplay"], timeout=15)
        if r and "driver = sdrplay" in r.stdout:
            return True
        if time.time() >= end:
            return False
        time.sleep(1)


def dumpvdl2_inputs(dumpvdl2=DUMPVDL2):
    """אילו קלטים קומפלו. ⚠ ‎--version מדפיס רק שורת גרסה — הרשימה מגיעה מ-‎--help."""
    r = _run([dumpvdl2, "--help"])
    text = ((r.stdout or "") + (r.stderr or "")) if r else ""
    return {k for k in ("--soapysdr", "--sdrplay3") if k in text}


# --- probe (שלב 1) ---------------------------------------------------------
PROFILE_OFFSETS_KHZ = (-800, -500, -300, -200, -150, -125, -100, -75, -50, -25,
                       25, 50, 75, 100, 125, 150, 200, 300, 500, 800)
CHAN_HALF_HZ = 8000           # ±8kHz סביב כל היסט (ערוץ VDL2 = 25kHz; DC ‏±2kHz מוחרג)


def channel_profile(freq_axis, psd, offsets_hz, half=CHAN_HALF_HZ, ref_hz=25000):
    """עוצמת רצפה ממוצעת סביב כל היסט, ב-dB *ביחס* לממוצע של ±ref_hz. טהור
    (רשימות) ⇒ נבדק ב-CI בלי numpy. ‏{offset_hz: rel_db או None כשאין בינים}."""
    def band(o):
        vals = [p for f, p in zip(freq_axis, psd) if abs(f - o) <= half and abs(f) > 2000]
        return sum(vals) / len(vals) if vals else None

    refs = [x for x in (band(ref_hz), band(-ref_hz)) if x]
    if not refs:
        return {o: None for o in offsets_hz}
    ref = sum(refs) / len(refs)
    out = {}
    for o in offsets_hz:
        p = band(o)
        out[o] = round(10 * math.log10(p / ref), 1) if p and p > 0 else None
    return out


def median_psd(iq, fs, nfft):
    """PSD חציוני (לא ממוצע): פרצי VDL2 קצרים לא מזיזים את החציון — מודדים רצפה."""
    import numpy as np
    k = len(iq) // nfft
    frames = iq[:k * nfft].reshape(k, nfft) * np.hanning(nfft)
    p = np.abs(np.fft.fft(frames, axis=1)) ** 2
    med = np.median(p, axis=0)
    return (np.fft.fftshift(np.fft.fftfreq(nfft, 1.0 / fs)).tolist(),
            np.fft.fftshift(med).tolist())


def _capture(dev, n, soapy, np):
    rx = soapy.SOAPY_SDR_RX
    st = dev.setupStream(rx, soapy.SOAPY_SDR_CF32)
    dev.activateStream(st)
    buf = np.empty(65536, np.complex64)
    out = np.empty(n, np.complex64)
    skip, got, errs = SAMPLE_RATE // 2, 0, 0      # 0.5ש' ראשונות: התייצבות אחרי שינוי
    try:
        while got < n:
            sr = dev.readStream(st, [buf], len(buf), timeoutUs=1000000)
            if sr.ret <= 0:
                errs += 1                          # overflow/timeout — PSD לא צריך רציפות
                if errs > 50:
                    raise RuntimeError(f"readStream נכשל שוב ושוב (ret={sr.ret})")
                continue
            chunk = buf[:sr.ret]
            if skip:
                drop = min(skip, len(chunk))
                chunk, skip = chunk[drop:], skip - drop
            take = min(len(chunk), n - got)
            out[got:got + take] = chunk[:take]
            got += take
    finally:
        dev.deactivateStream(st)
        dev.closeStream(st)
    return out


def cmd_probe(args):
    problems = preflight(need_root=not args.no_root_check)
    if problems:
        print("\n".join("✗ " + p for p in problems))
        return 2
    try:
        import SoapySDR
    except ImportError:
        print("✗ חסר python3-soapysdr:  sudo apt install python3-soapysdr")
        return 2
    freqs = mhz_to_hz(args.freqs)
    center, bw_req = dumpvdl2_center(freqs), dumpvdl2_bandwidth(freqs)
    rx = SoapySDR.SOAPY_SDR_RX
    try:
        dev = SoapySDR.Device("driver=sdrplay")
    except (RuntimeError, ValueError) as e:
        print(f"✗ פתיחת ה-SDR נכשלה ({e}) — תפוס ע\"י תוכנה אחרת? ר' חיווי ה-SDR בממשק")
        return 2
    # בדיוק סדר הקריאות של soapysdr_init ב-dumpvdl2: rate ⇒ freq ⇒ bandwidth
    dev.setSampleRate(rx, 0, SAMPLE_RATE)
    dev.setFrequency(rx, 0, center)
    dev.setBandwidth(rx, 0, bw_req)
    got = dev.getBandwidth(rx, 0)
    result = {"center_hz": center, "requested_bw_hz": bw_req, "readback_bw_hz": got,
              "expected_from_source_hz": soapy_sdrplay_bw(bw_req),
              "listed_bw_hz": list(dev.listBandwidths(rx, 0))}
    print(f"מרכז {center/1e6:.4f} MHz · dumpvdl2 מבקש {bw_req} Hz ⇒ getBandwidth = {got:.0f} Hz "
          f"(לפי המקור: {result['expected_from_source_hz']})")
    print("רוחבים שהדרייבר מציע:", ", ".join(f"{b/1e3:g}k" for b in result["listed_bw_hz"]))
    for f, (off, g) in sorted(classify(freqs).items()):
        print(f"  {f/1e6:.3f} MHz  היסט {off/1e3:+.0f} kHz  ({g})")

    try:
        import numpy as np
    except ImportError:
        np = None
    if np is None or args.no_shape:
        if np is None:
            print("\n(בלי python3-numpy — רק readback. לצורת המסנן: sudo apt install python3-numpy)")
    else:
        gain = args.gain_tuple if args.gain_tuple else (40, 0)
        dev.setGainMode(rx, 0, False)              # AGC כבוי: שתי הלכידות באותו רווח בדיוק
        dev.setGain(rx, 0, "IFGR", gain[0])
        dev.setGain(rx, 0, "RFGR", gain[1])
        nfft = 4200                                # 500Hz לבין ב-2.1MS/s
        offs = sorted(set(o * 1000 for o in PROFILE_OFFSETS_KHZ) | {f - center for f in freqs})
        profiles = {}
        for bw in (bw_req, NATIVE_BW):
            dev.setBandwidth(rx, 0, bw)
            rb = dev.getBandwidth(rx, 0)
            iq = _capture(dev, int(SAMPLE_RATE * args.seconds), SoapySDR, np)
            fa, psd = median_psd(iq, SAMPLE_RATE, nfft)
            profiles[int(rb)] = channel_profile(fa, psd, offs)
        result["shape_gain"] = {"IFGR": gain[0], "RFGR": gain[1]}
        result["profiles_rel_db"] = {str(k): {str(o): v for o, v in p.items()}
                                     for k, p in profiles.items()}
        narrow, wide = sorted(profiles)
        print(f"\nרצפת הרעש ביחס ל-±25kHz (IFGR={gain[0]} RFGR={gain[1]}, AGC כבוי). "
              "האנטנה מחוברת כרגיל — רעש האנטנה הוא 'אות הבדיקה':")
        print(f"  {'היסט kHz':>9} {narrow/1e3:>7g}k {wide/1e3:>7g}k  {'הפרש':>6}")
        for o in offs:
            a, b = profiles[narrow].get(o), profiles[wide].get(o)
            d = f"{a - b:+6.1f}" if a is not None and b is not None else "     —"
            fa_ = f"{a:+7.1f}" if a is not None else "      —"
            fb_ = f"{b:+7.1f}" if b is not None else "      —"
            mark = "  ◀ ערוץ" if any(o == f - center for f in freqs) else ""
            print(f"  {o/1e3:>+9.0f} {fa_} {fb_}  {d}{mark}")
        print("\n'הפרש' = כמה המסנן הצר מוריד את רצפת הרעש בהיסט הזה, מעבר למה שהרחב מוריד.\n"
              "זה *מנגנון*, לא פסק-דין: אם הרצפה צונחת, גם האות צונח — מה שקובע הוא אם\n"
              "רעש שנוסף *אחרי* המסנן (ADC) מתחיל לשלוט. את זה מכריע רק ab (פריימים, SNR).")
    try:
        SoapySDR.Device.unmake(dev)
    except Exception:
        pass
    run_dir = OUT_ROOT / ("probe-" + datetime.now().strftime("%Y%m%d-%H%M%S"))
    run_dir.mkdir(parents=True, exist_ok=True)
    (run_dir / "probe.json").write_text(json.dumps(result, indent=1), encoding="utf-8")
    print(f"\nנשמר: {run_dir / 'probe.json'}")
    return 0


# --- ab (שלב 2) ------------------------------------------------------------
def _write_json(path, obj):
    tmp = Path(str(path) + ".tmp")
    tmp.write_text(json.dumps(obj, indent=1), encoding="utf-8")
    os.replace(tmp, path)


def _stop(proc, grace=10):
    """SIGTERM ⇒ dumpvdl2 מרים do_exit ומשחרר את ה-SDR כמו שצריך; kill רק אם נתקע."""
    if proc.poll() is not None:
        return
    proc.terminate()
    try:
        proc.wait(timeout=grace)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()


def _interrupt(signum, frame):
    raise KeyboardInterrupt


def run_ab(args, freqs, gain, run_dir, dumpvdl2=DUMPVDL2, check=preflight, ready=sdr_ready):
    """הלולאה עצמה (בלי בדיקות פתיחה) — נקראת גם מהבדיקות עם dumpvdl2 מזויף."""
    n_blocks = max(2, int(round(args.minutes / args.block)))
    n_blocks += n_blocks % 2
    sched = schedule(n_blocks)
    block_sec = args.block * 60
    meta = {"freqs_hz": freqs, "groups": {str(f): g for f, (o, g) in classify(freqs).items()},
            "offsets_hz": {str(f): o for f, (o, g) in classify(freqs).items()},
            "gain": list(gain) if gain else "agc", "block_sec": block_sec,
            "settle_sec": args.settle, "schedule": sched, "port": args.port,
            "cmd": {a: build_cmd(a, freqs, gain, args.port, dumpvdl2, args.device) for a in "AB"},
            "requested_bw_hz": dumpvdl2_bandwidth(freqs),
            "bw_hz": {"A": soapy_sdrplay_bw(dumpvdl2_bandwidth(freqs)), "B": NATIVE_BW},
            "started": datetime.now().isoformat(timespec="seconds")}
    _write_json(run_dir / "meta.json", meta)
    recv = Receiver(args.port, run_dir / "frames.jsonl")
    recv.start()
    blocks = []
    old = {s: signal.signal(s, _interrupt) for s in (signal.SIGTERM, signal.SIGHUP)}
    proc = cur = None
    try:
        for i, arm in enumerate(sched):
            problems = check()
            if problems:
                print("✗ נעצר לפני בלוק %d: %s" % (i, "; ".join(problems)))
                break
            if not ready():
                print(f"✗ ה-SDR לא זמין לפני בלוק {i} (SoapySDRUtil --find ריק) — נעצר")
                break
            cmd = meta["cmd"][arm]
            log_path = run_dir / f"block{i:02d}-{arm}.log"
            print(f"[{datetime.now():%H:%M:%S}] בלוק {i + 1}/{n_blocks}  זרוע {arm}  "
                  f"({'200kHz, SoapySDR' if arm == 'A' else '1.536MHz, sdrplay3'})", flush=True)
            with open(log_path, "w", encoding="utf-8") as log:
                recv.set_block(i)
                start = time.time()
                cur = {"i": i, "arm": arm, "start": start, "log": log_path.name}
                proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=log)
                status = "ok"
                while time.time() - start < block_sec:
                    if proc.poll() is not None:
                        status = "exited"
                        break
                    time.sleep(0.5)
                end = time.time()
                _stop(proc)
                recv.set_block(None)
            blocks.append({"i": i, "arm": arm, "start": start, "end": end,
                           "settle": args.settle, "status": status, "rc": proc.returncode,
                           "log": log_path.name})
            _write_json(run_dir / "blocks.json", blocks)
            proc = cur = None
            if status != "ok":
                tail = log_path.read_text(encoding="utf-8", errors="replace").splitlines()[-8:]
                print(f"✗ dumpvdl2 יצא באמצע בלוק {i} (rc={blocks[-1]['rc']}):")
                print("\n".join("    " + t for t in tail))
                break
            time.sleep(args.gap)
    except KeyboardInterrupt:
        print("\n⏹ נעצר — משחרר את ה-SDR ומנתח את הבלוקים שהושלמו")
        if proc is not None:
            _stop(proc)
        if cur is not None:                        # בלוק חלקי — נרשם, לא נספר בניתוח
            blocks.append({**cur, "end": time.time(), "settle": args.settle,
                           "status": "interrupted", "rc": proc.returncode if proc else None})
            _write_json(run_dir / "blocks.json", blocks)
    finally:
        for s, h in old.items():
            signal.signal(s, h)
        recv.close()
    return blocks


def cmd_ab(args):
    if args.port == 5557:
        print("✗ 5557 שייך ל-airam-web (VDL2_UDP_PORT) — בחר פורט אחר")
        return 2
    freqs = mhz_to_hz(args.freqs)
    groups = {g for _, g in classify(freqs).values()}
    if "outer" not in groups or "inner" not in groups:
        print("✗ צריך גם ערוץ מחוץ ל-±100kHz וגם ערוץ בתוך ±50kHz מהמרכז — אחרת אין מה לבדוק "
              "או אין בקרה. ברירת המחדל (5 הערוצים) מתאימה.")
        return 2
    problems = preflight(need_root=not args.no_root_check)
    if not shutil.which(args.dumpvdl2) and not Path(args.dumpvdl2).exists():
        problems.append(f"{args.dumpvdl2} לא נמצא (install.sh שלב 4c)")
    else:
        have = dumpvdl2_inputs(args.dumpvdl2)
        for k in ("--soapysdr", "--sdrplay3"):
            if k not in have:
                problems.append(f"dumpvdl2 נבנה בלי {k} — זרוע {'A' if k == '--soapysdr' else 'B'} "
                                "לא אפשרית (ב-cmake: ‏sdrplay v3 / soapysdr enabled?)")
    if problems:
        print("\n".join("✗ " + p for p in problems))
        return 2
    if args.gain_tuple is not None or (args.gain or "").lower() == "agc":
        gain = args.gain_tuple
    else:
        try:
            gain = parse_gain(read_env(VDL2_ENV).get("VDL2_GAIN", ""))
        except ValueError as e:
            print(f"✗ {e} — העבר ‎--gain agc או ‎--gain IFGR,LNA")
            return 2
    run_dir = OUT_ROOT / datetime.now().strftime("%Y%m%d-%H%M%S")
    run_dir.mkdir(parents=True, exist_ok=True)
    print(f"ריצה: {run_dir}\nרווח: {'AGC (כמו ב-AIR-AM כברירת מחדל)' if not gain else gain}  ·  "
          f"{args.minutes:g} דק' בבלוקים של {args.block:g}  ·  התייצבות {args.settle:g}ש' מושלכת")
    try:
        run_ab(args, freqs, gain, run_dir, dumpvdl2=args.dumpvdl2)
    except OSError as e:
        print(f"✗ {e}")
        return 2
    rep = analyze(run_dir)
    print(format_report(rep))
    _write_json(run_dir / "report.json", rep)
    return 0


# --- ניתוח (טהור; נבדק ב-CI) -------------------------------------------------
# t_{0.975} לפי דרגות חופש — בלי scipy על ה-Pi.
_T975 = (12.706, 4.303, 3.182, 2.776, 2.571, 2.447, 2.365, 2.306, 2.262, 2.228,
         2.201, 2.179, 2.160, 2.145, 2.131, 2.120, 2.110, 2.101, 2.093, 2.086,
         2.080, 2.074, 2.069, 2.064, 2.060, 2.056, 2.052, 2.048, 2.045, 2.042)


def t975(df):
    return _T975[df - 1] if 1 <= df <= len(_T975) else 1.96


def ratio_of_ratios(oA, iA, oB, iB):
    """(oB/oA)/(iB/iA) עם CI 95% (Woolf, לוג; ‏+0.5 לכל תא כשיש אפס). פואסוני ⇒
    אופטימי כשהתעבורה 'גושית' — ולכן תמיד מוצג לצד ההשוואה הזוגית."""
    cells = [oA, iA, oB, iB]
    if min(cells) == 0:
        cells = [c + 0.5 for c in cells]
    a, b, c, d = cells
    rr = (c / a) / (d / b)
    se = math.sqrt(1 / a + 1 / b + 1 / c + 1 / d)
    return {"rr": rr, "lo": rr * math.exp(-1.96 * se), "hi": rr * math.exp(1.96 * se)}


def rate_ratio(nA, tA, nB, tB):
    """(nB/tB)/(nA/tA) — רק כשאין בקרה (אין תעבורה בערוצים הפנימיים)."""
    a, b = (nA, nB) if min(nA, nB) else (nA + 0.5, nB + 0.5)
    rr = (b / tB) / (a / tA)
    se = math.sqrt(1 / a + 1 / b)
    return {"rr": rr, "lo": rr * math.exp(-1.96 * se), "hi": rr * math.exp(1.96 * se)}


def _med(xs):
    xs = [x for x in xs if x is not None]
    return round(statistics.median(xs), 1) if xs else None


def load_run(run_dir):
    run_dir = Path(run_dir)
    meta = json.loads((run_dir / "meta.json").read_text(encoding="utf-8"))
    try:
        blocks = json.loads((run_dir / "blocks.json").read_text(encoding="utf-8"))
    except OSError:
        blocks = []
    frames = []
    try:
        with open(run_dir / "frames.jsonl", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue                       # שורה קטועה (Ctrl-C באמצע כתיבה)
                if isinstance(rec, dict):
                    frames.append(rec)
    except OSError:
        pass
    return meta, blocks, frames


def windowed(blocks, frames):
    """{block_i: [frames]} — רק בלוקים שהושלמו, ורק פריימים בחלון [start+settle, end]."""
    good = {b["i"]: b for b in blocks if b.get("status") == "ok"}
    out = {i: [] for i in good}
    for fr in frames:
        b = good.get(fr.get("b"))
        if b and b["start"] + b["settle"] <= fr.get("rx", 0) <= b["end"]:
            out[b["i"]].append(fr)
    return out


def analyze(run_dir):
    meta, blocks, frames = load_run(run_dir)
    groups = {int(f): g for f, g in meta["groups"].items()}
    offsets = {int(f): o for f, o in meta["offsets_hz"].items()}
    win = windowed(blocks, frames)
    arm_of = {b["i"]: b["arm"] for b in blocks if b["i"] in win}
    eff = {b["i"]: max(0.0, b["end"] - b["start"] - b["settle"]) for b in blocks if b["i"] in win}

    rep = {"run": str(run_dir), "meta": {k: meta[k] for k in
                                         ("freqs_hz", "gain", "block_sec", "settle_sec",
                                          "requested_bw_hz", "bw_hz", "started")},
           "blocks_ok": len(win), "blocks_total": len(blocks), "arms": {}, "did": {}}
    for arm in "AB":
        idx = [i for i, a in arm_of.items() if a == arm]
        secs = sum(eff[i] for i in idx)
        fr = [f for i in idx for f in win[i]]
        chans = {}
        for f in meta["freqs_hz"]:
            mine = [x for x in fr if x.get("f") == f]
            snr = [x["sig"] - x["noise"] for x in mine
                   if x.get("sig") is not None and x.get("noise") is not None]
            fec = [x["fec"] for x in mine if x.get("fec") is not None]
            chans[str(f)] = {
                "offset_khz": offsets[f] / 1e3, "group": groups[f], "n": len(mine),
                "n_air": sum(1 for x in mine if x.get("src") == "air"),
                "per_hour": round(len(mine) * 3600 / secs, 1) if secs else None,
                "sig_med": _med([x.get("sig") for x in mine]),
                "noise_med": _med([x.get("noise") for x in mine]),
                "snr_med": _med(snr),
                "fec_frac": round(sum(1 for v in fec if v > 0) / len(fec), 3) if fec else None}
        rep["arms"][arm] = {"blocks": len(idx), "seconds": round(secs), "channels": chans}

    def count(arm, group, air=False):
        return sum(c["n_air" if air else "n"] for c in rep["arms"][arm]["channels"].values()
                   if c["group"] == group)

    for label, air in (("all", False), ("aircraft", True)):
        oA, iA, oB, iB = (count("A", "outer", air), count("A", "inner", air),
                          count("B", "outer", air), count("B", "inner", air))
        d = {"counts": {"A_outer": oA, "A_inner": iA, "B_outer": oB, "B_inner": iB}}
        if iA + iB == 0:
            d["no_control"] = True
            tA, tB = rep["arms"]["A"]["seconds"], rep["arms"]["B"]["seconds"]
            if tA and tB and oA + oB:
                d["rate_ratio"] = rate_ratio(oA, tA, oB, tB)
        elif oA + oB:
            d["pooled"] = ratio_of_ratios(oA, iA, oB, iB)
        rep["did"][label] = d
    # פר-ערוץ חיצוני מול כל הפנימיים יחד (136.725 ו-136.975 יכולים להתנהג שונה)
    inner_A, inner_B = count("A", "inner"), count("B", "inner")
    rep["did_per_channel"] = {}
    for f, g in groups.items():
        if g != "outer" or not (inner_A + inner_B):
            continue
        a, b = rep["arms"]["A"]["channels"][str(f)]["n"], rep["arms"]["B"]["channels"][str(f)]["n"]
        if a + b:
            rep["did_per_channel"][str(f)] = ratio_of_ratios(a, inner_A, b, inner_B)

    # השוואה זוגית: בלוקים סמוכים (ABBA ⇒ זוגות 0-1, 2-3, …), חלק הפריימים החיצוניים
    # בכל בלוק. השונות בין הזוגות כוללת את ה"גושיות" האמיתית של התעבורה.
    order = sorted(win)
    diffs = []
    for k in range(0, len(order) - 1, 2):
        i, j = order[k], order[k + 1]
        if {arm_of[i], arm_of[j]} != {"A", "B"}:
            continue
        share = {}
        for b in (i, j):
            o = sum(1 for x in win[b] if groups.get(x.get("f")) == "outer")
            n = o + sum(1 for x in win[b] if groups.get(x.get("f")) == "inner")
            share[arm_of[b]] = o / n if n else None
        if share["A"] is not None and share["B"] is not None:
            diffs.append(share["B"] - share["A"])
    paired = {"pairs": len(diffs)}
    if len(diffs) >= 2:
        m, sd = statistics.mean(diffs), statistics.stdev(diffs)
        h = t975(len(diffs) - 1) * sd / math.sqrt(len(diffs))
        paired.update(mean=m, lo=m - h, hi=m + h)
    rep["paired_outer_share"] = paired

    # מנגנון: רצפת הרעש של כל ערוץ חיצוני פחות זו של הפנימיים, בכל זרוע
    shape = {}
    for arm in "AB":
        ch = rep["arms"][arm]["channels"]
        inner = [c["noise_med"] for c in ch.values() if c["group"] == "inner" and c["noise_med"] is not None]
        ref = statistics.mean(inner) if inner else None
        shape[arm] = {f: (round(c["noise_med"] - ref, 1) if ref is not None and c["noise_med"] is not None else None)
                      for f, c in ch.items() if c["group"] == "outer"}
    rep["noise_outer_minus_inner_db"] = shape
    return rep


def _ci(d):
    return f"{d['rr']:.2f}  [95%: {d['lo']:.2f}–{d['hi']:.2f}]" + (
        "  ✓ לא כולל 1" if d["lo"] > 1 or d["hi"] < 1 else "  ~ כולל 1")


def _cell(v, width, fmt):
    return format(v, fmt).rjust(width) if v is not None else "—".rjust(width)


def format_report(rep):
    m = rep["meta"]
    L = [f"\n=== VDL2 IF filter A/B — {rep['run']}",
         f"A = SoapySDR (מבקש {m['requested_bw_hz']} ⇒ מסנן {m['bw_hz']['A']})  ·  "
         f"B = sdrplay3 (מסנן {m['bw_hz']['B']})  ·  רווח: {m['gain']}",
         f"בלוקים תקינים: {rep['blocks_ok']}/{rep['blocks_total']}  ·  "
         f"A {rep['arms']['A']['seconds']}ש'  B {rep['arms']['B']['seconds']}ש'", ""]
    L.append(f"{'ערוץ':>8} {'היסט':>6} {'קבוצה':>6} | {'A n':>5} {'air':>4} {'/h':>6} "
             f"{'SNR':>5} {'noise':>6} {'fec%':>5} | {'B n':>5} {'air':>4} {'/h':>6} "
             f"{'SNR':>5} {'noise':>6} {'fec%':>5}")
    for f in m["freqs_hz"]:
        row = [f"{f/1e6:8.3f}"]
        a = rep["arms"]["A"]["channels"][str(f)]
        row.append(f"{a['offset_khz']:+6.0f} {a['group']:>6} |")
        for arm in "AB":
            c = rep["arms"][arm]["channels"][str(f)]
            fec = None if c["fec_frac"] is None else 100 * c["fec_frac"]
            row.append(f"{c['n']:5d} {c['n_air']:4d} {_cell(c['per_hour'], 6, '.0f')} "
                       f"{_cell(c['snr_med'], 5, '.1f')} {_cell(c['noise_med'], 6, '.1f')} "
                       f"{_cell(fec, 5, '.0f')}"
                       + (" |" if arm == "A" else ""))
        L.append(" ".join(row))
    L.append("")
    for label, name in (("all", "כל הפריימים"), ("aircraft", "רק פריימים ממטוסים")):
        d = rep["did"].get(label, {})
        c = d.get("counts", {})
        L.append(f"[{name}] חיצוני/פנימי — A {c.get('A_outer')}/{c.get('A_inner')}  "
                 f"B {c.get('B_outer')}/{c.get('B_inner')}")
        if "pooled" in d:
            L.append(f"   יחס-יחסים B מול A: {_ci(d['pooled'])}")
        elif d.get("no_control"):
            L.append("   ⚠ אין תעבורה בערוצים הפנימיים — אין בקרה; השוואת קצב בלבד (ABBA לבד):")
            if "rate_ratio" in d:
                L.append(f"   קצב חיצוני B/A: {_ci(d['rate_ratio'])}")
        else:
            L.append("   אין פריימים בערוצים החיצוניים")
    for f, d in rep["did_per_channel"].items():
        L.append(f"   {int(f)/1e6:.3f} מול הפנימיים: {_ci(d)}")
    p = rep["paired_outer_share"]
    if "mean" in p:
        sig = "✓ לא כולל 0" if p["lo"] > 0 or p["hi"] < 0 else "~ כולל 0"
        L.append(f"זוגות בלוקים ({p['pairs']}): חלק-חיצוני B−A = {p['mean']:+.3f}  "
                 f"[95%: {p['lo']:+.3f} – {p['hi']:+.3f}]  {sig}")
    else:
        L.append(f"זוגות בלוקים: {p['pairs']} — מעט מדי להשוואה זוגית")
    sh = rep["noise_outer_minus_inner_db"]
    L.append("רצפת רעש חיצוני−פנימי (dB): " + "  ".join(
        f"{arm}: " + ", ".join(f"{int(f)/1e6:.3f}={v:+.1f}" if v is not None else f"{int(f)/1e6:.3f}=—"
                               for f, v in sh[arm].items()) for arm in "AB"))
    L.append("\nכלל ההחלטה (docs/vdl2-if-filter-design.md §6): משנים את היחידה רק אם *גם* יחס-היחסים\n"
             "(כל הפריימים) *וגם* ההשוואה הזוגית לא כוללים 'אין הבדל', לטובת B. אחרת — מתעדים.")
    return "\n".join(L)


def cmd_analyze(args):
    rep = analyze(args.run_dir)
    print(format_report(rep))
    _write_json(Path(args.run_dir) / "report.json", rep)
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(description="AIR-AM: ניסוי מסנן ה-IF של VDL2 (ר' docs/vdl2-if-filter-design.md)")
    sub = ap.add_subparsers(dest="cmd", required=True)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--freqs", default=",".join(DEFAULT_FREQS_MHZ),
                        help="MHz, מופרדים בפסיק (ברירת מחדל: בנק עולמי+אירופה)")
    common.add_argument("--gain", default=None,
                        help="'agc' או 'IFGR,LNA' (למשל 40,0). ברירת מחדל ב-ab: כמו vdl2.env; ב-probe: 40,0")
    common.add_argument("--no-root-check", action="store_true", help=argparse.SUPPRESS)

    p = sub.add_parser("probe", parents=[common], help="readback של getBandwidth + צורת המסנן")
    p.add_argument("--seconds", type=float, default=2.0, help="משך כל לכידה (ברירת מחדל 2)")
    p.add_argument("--no-shape", action="store_true", help="readback בלבד")

    p = sub.add_parser("ab", parents=[common], help="A/B משולב: SoapySDR (200k) מול sdrplay3 (1.536M)")
    p.add_argument("--minutes", type=float, default=60.0)
    p.add_argument("--block", type=float, default=5.0, help="דקות לבלוק (ברירת מחדל 5)")
    p.add_argument("--settle", type=float, default=20.0, help="שניות מושלכות בתחילת כל בלוק")
    p.add_argument("--gap", type=float, default=3.0, help="שניות בין בלוקים")
    p.add_argument("--port", type=int, default=UDP_PORT)
    p.add_argument("--device", default="0", help="‎--sdrplay3: אינדקס או מספר סידורי (ברירת מחדל 0)")
    p.add_argument("--dumpvdl2", default=DUMPVDL2)

    p = sub.add_parser("analyze", help="ניתוח מחדש של ריצה שמורה")
    p.add_argument("run_dir")

    args = ap.parse_args(argv)
    if args.cmd in ("probe", "ab"):
        args.freqs = [x.strip() for x in args.freqs.split(",") if x.strip()]
        args.gain_tuple = None
        if args.gain:
            try:
                args.gain_tuple = parse_gain_arg(args.gain)
            except ValueError:
                ap.error("‎--gain: 'agc' או 'IFGR,LNA'")
    return {"probe": cmd_probe, "ab": cmd_ab, "analyze": cmd_analyze}[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
