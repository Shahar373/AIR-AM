def my_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("192.0.2.1", 9))        # UDP connect לא שולח דבר — רק בוחר ממשק
        ip = s.getsockname()[0]
        s.close()
        return ip
    except OSError:
        return socket.gethostname()


def main(argv=None):
    ap = argparse.ArgumentParser(description="AIR-AM — מעבדת האזנה עיוורת לסינון רעשים")
    ap.add_argument("files", nargs="*", help="קובצי MP3 מסוימים (ברירת מחדל: ההקלטות האחרונות)")
    ap.add_argument("-n", type=int, default=5, help="כמה הקלטות (ברירת מחדל 5)")
    ap.add_argument("--rec-dir", type=Path, default=REC_DIR)
    ap.add_argument("--out", type=Path, default=OUT_DIR)
    ap.add_argument("--port", type=int, default=PORT)
    ap.add_argument("--rnnoise", default=RNNOISE_BIN)
    ap.add_argument("--rebuild", action="store_true", help="לבנות מחדש ולזרוק דירוגים קיימים")
    ap.add_argument("--no-serve", action="store_true", help="רק לבנות, בלי שרת")
    a = ap.parse_args(argv)

    if not shutil.which("ffmpeg"):
        sys.exit("ffmpeg חסר (sudo apt install ffmpeg)")
    lab = None if a.rebuild else load_lab(a.out)
    if lab:
        print(f"ממשיך מעבדה קיימת ב-{a.out} ({len(lab['recs'])} הקלטות). --rebuild לבנייה מחדש.")
    else:
        paths = [Path(f) for f in a.files] or pick_recordings(a.rec_dir, a.n)
        if not paths:
            sys.exit(f"לא נמצאו הקלטות של {MIN_SEC:.0f} שניות ומעלה ב-{a.rec_dir}.\n"
                     "הקלטות נוצרות רק כשהסקוולץ' אינו 'פתוח'. אם התיקייה לא קריאה — הרץ עם sudo.")
        if a.out.exists():
            shutil.rmtree(a.out)
        print(f"בונה מעבדה מ-{len(paths)} הקלטות:")
        try:
            lab = build(paths, a.out, a.rnnoise)
        except (RuntimeError, OSError) as e:
            sys.exit(f"הבנייה נכשלה: {e}")
    for vid, why in lab.get("skipped", {}).items():
        print(f"  [!] {vid} לא נבנה: {why}")
    if a.no_serve:
        return
    srv = ThreadingHTTPServer(("0.0.0.0", a.port), make_handler(a.out, threading.Lock()))
    print(f"\nפתח בטלפון:  http://{my_ip()}:{a.port}\nCtrl-C לסיום. התוצאות יישמרו ב-{a.out}/results.txt")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print()
    lab = load_lab(a.out)
    if lab and lab.get("done"):
        print(results_text(lab))


if __name__ == "__main__":
    main()
