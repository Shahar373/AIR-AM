[Unit]
Description=AIR-AM - RTLSDR-Airband aviation receiver (SDRplay RSP1B)
Documentation=https://github.com/rtl-airband/RTLSDR-Airband/wiki
After=network-online.target icecast2.service sdrplay.service
Wants=network-online.target
# Requires => עצירת sdrplay עוצרת גם את rtl_airband (תלות קשיחה ב-API).
# אבל dependency-stop הוא עצירה "נקייה" ש-Restart=always לא מתאושש ממנה —
# לכן PartOf: מפיץ גם restart של sdrplay אלינו (try-restart: רק אם אנחנו
# פעילים כרגע => לא מפעיל את שני צרכני ה-SDR ולא שובר את ה-Conflicts).
Requires=sdrplay.service
PartOf=sdrplay.service
# בלי הגבלת קצב-הפעלה => מתאושש לנצח (ניתוק/חיבור USB, מרוץ אתחול)
StartLimitIntervalSec=0

[Service]
Type=simple
# שער מוכנות: מחכה שה-SDRplay API באמת יענה לפני הרצת rtl_airband
ExecStartPre=/usr/local/bin/airam-wait-sdrplay %n
ExecStart=/usr/local/bin/rtl_airband -f -c /etc/rtl_airband/airband.conf
# rtl_airband זקוק להרשאות root לגישת חומרה ולעדיפות זמן-אמת
User=root
Restart=always
RestartSec=10

# אין [Install] בכוונה: השירות *לא* enabled (לא עולה באתחול). כמו airam-acars
# ו-airam-vdl2 — airam-web (המתזמר) קורא את state.json באתחול ומפעיל את המצב
# השמור. אין "מצב ראשי": קול/ACARS/VDL2 שווי-מעמד, וכיבוי (off) שורד reboot.
