[Unit]
Description=AIR-AM web tuner (frequency selector UI)
# airam-web הוא המתזמר (orchestrator) של ה-SDR: השירות היחיד שקם באתחול מבין
# מפעילי-המצבים — קורא את state.json ומשחזר את המצב השמור (voice/acars/vdl2/off).
After=network-online.target icecast2.service
Wants=network-online.target
# ⚠ רגרסיה אמיתית: היה ב-[Service] (מיקום שהתקף רק לפני systemd 230) — systemd
# מודרני מתעלם ממנו שם בשקט (systemd-analyze verify תפס: "Unknown key name
# 'StartLimitIntervalSec' in section 'Service'"), כך שהמשטח היחיד של הבקרה
# היה כפוף לתקרת ברירת-המחדל של systemd במקום "מתאושש לנצח" כפי שההערה למטה
# מתעדת בכוונה — קריסה חוזרת (למשל באג בקוד) הייתה יכולה להשבית את airam-web
# לצמיתות (start-limit-hit) בלי אף התאוששות אוטומטית, בניגוד למטרה #3 בפרויקט.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/airam/webtune
# PIN אופציונלי (AIRAM_PIN=...) - הקובץ אופציונלי (-), נוצר ע"י install.sh
EnvironmentFile=-/etc/airam/airam.env
ExecStart=/usr/bin/python3 /opt/airam/webtune/app.py
# חיזוק אבטחה: רץ כמשתמש לא-root. כתיבת ההגדרות מתאפשרת ע"י chown של
# /etc/rtl_airband ו-/var/lib/airam, וה-restart של rtl_airband דרך sudoers ממוקד.
# קבוצות journal/video (journalctl, vcgencmd) מגיעות מחברות המשתמש (install.sh).
User=airam
Group=airam
# always (לא on-failure): זה משטח הבקרה היחיד — חייב לקום גם אחרי יציאה "נקייה"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
